# COROS Training Hub credentials (used by the fetcher; unofficial API — see docs/adr/0001)
COROS_EMAIL=you@example.com
COROS_PASSWORD=changeme
# Regional API host — must match your account's home region.
# US: https://teamapi.coros.com (default)  EU: https://teameuapi.coros.com
COROS_API_BASE=https://teamapi.coros.com

# Timezone for local dates / time-of-day buckets
LOCAL_TZ=America/Chicago
# Max heart rate for effort buckets
MAX_HR=190
